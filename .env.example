# MetaTrader5 credential defaults for local development.
# Copy this file to .env and replace the values for your account.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
USE_SIMULATOR=true
SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,NZDUSD
FORECAST_HORIZON_SECONDS=120
SIGNAL_CONFIDENCE_THRESHOLD=0.55
DEFAULT_VOLUME=0.01
MAX_LOOKBACK_BARS=5000
